{% extends 'base.html.twig' %}
{% block title %}Sign in{% endblock %}
{% block body %}
<h1>Sign in</h1>
{% if error %}<p><mark>{{ error.messageKey|trans(error.messageData, 'security') }}</mark></p>{% endif %}
<form method="post">
    <input type="email" name="_username" value="{{ last_username }}" placeholder="Email" required autofocus>
    <input type="password" name="_password" placeholder="Password" required>
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
    <button>Sign in</button>
</form>
{% endblock %}
