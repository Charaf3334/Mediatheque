<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Médiathèque{% endblock %}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
</head>
<body>
<main class="container">
    <nav>
        <ul><li><strong><a href="/">Médiathèque</a></strong></li></ul>
        <ul>
            {% if is_granted('ROLE_USER') %}
                <li><a href="/my">My loans</a></li>
                {% if is_granted('ROLE_LIBRARIAN') %}<li><a href="/admin/desk">Desk</a></li><li><a href="/stats">Stats</a></li><li><a href="/admin">Admin</a></li>{% endif %}
                <li><a href="{{ path('app_logout') }}">Logout ({{ app.user.userIdentifier }})</a></li>
            {% else %}
                <li><a href="{{ path('app_login') }}">Sign in</a></li>
            {% endif %}
        </ul>
    </nav>
    {% for type, msgs in app.flashes %}{% for m in msgs %}<p><mark>{{ m }}</mark></p>{% endfor %}{% endfor %}
    {% block body %}{% endblock %}
</main>
</body>
</html>
